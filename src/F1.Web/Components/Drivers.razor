@using F1.Client

<thead>
    <tr>
        <th>Position</th>
        <th>Driver</th>
        <th>Code</th>
        <th>Nationality</th>
        <th>Constructor</th>
        <th>Wins</th>
        <th>Points</th>
    </tr>
</thead>
<tbody>
    @foreach (var driverStanding in DriverStandingsList.DriverStandings)
    {
        var constructor = driverStanding.Constructors.LastOrDefault();
        <tr>
            <td>@driverStanding.PositionText</td>
            <td><MudLink Href=@($"drivers/{DriverStandingsList.Season}/{driverStanding.Driver.DriverId}")>@driverStanding.Driver.GivenName @driverStanding.Driver.FamilyName</MudLink></td>
            <td>@driverStanding.Driver.Code @driverStanding.Driver.PermanentNumber</td>
            <td>@driverStanding.Driver.Nationality</td>
            <td><MudLink Href=@($"constructors/{DriverStandingsList.Season}/{constructor?.ConstructorId}")>@constructor?.Name</MudLink></td>
            <td>@driverStanding.Wins</td>
            <td>@driverStanding.Points</td>
        </tr>
    }
</tbody>

@code
{
    [Parameter]
    [EditorRequired]
    public required DriverStandingsList DriverStandingsList { get; init; }
}
